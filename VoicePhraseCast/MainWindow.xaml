<Window x:Class="VoicePhraseCast.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:VoicePhraseCast"
        mc:Ignorable="d"
        Title="VoicePhraseCast" 
        Width="380"
        SizeToContent="Height"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent" 
        SnapsToDevicePixels="True" 
        UseLayoutRounding="True"
        WindowStartupLocation="CenterScreen" 
        ResizeMode="CanMinimize"
        ShowInTaskbar="True"
        Icon="pack://application:,,,/Resources/VoicePhraseCast.ico">

    <Window.Resources>
        <!-- 1. Базовые стили для простых элементов -->
        <Style TargetType="TextBlock">
            <Setter Property="Foreground" Value="#7A8B9E"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontFamily" Value="Segoe UI Semibold"/>
        </Style>

        <!-- 2. Стили ComboBox -->
        <Style TargetType="ComboBox">
            <Setter Property="Height" Value="24"/>
            <Setter Property="Foreground" Value="#68768A"/>
            <Setter Property="HorizontalContentAlignment" Value="Left"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="SnapsToDevicePixels" Value="True"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBox">
                        <Grid>
                            <ToggleButton x:Name="ToggleButton" 
                                          BorderBrush="#221617" 
                                          Background="#0A0D14" 
                                          Focusable="false"
                                          IsChecked="{Binding IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}" 
                                          ClickMode="Press">
                                <ToggleButton.Template>
                                    <ControlTemplate TargetType="ToggleButton">
                                        <Border x:Name="Border" 
                                                Background="{TemplateBinding Background}" 
                                                BorderBrush="{TemplateBinding BorderBrush}" 
                                                BorderThickness="1" 
                                                CornerRadius="2">
                                            <Grid HorizontalAlignment="Right" Width="20">
                                                <Path x:Name="Arrow" 
                                                      Fill="#475569" 
                                                      Data="M0,0 L4,4 L8,0 Z" 
                                                      HorizontalAlignment="Center" 
                                                      VerticalAlignment="Center"/>
                                            </Grid>
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="true">
                                                <Setter TargetName="Arrow" Property="Fill" Value="#991B1B"/>
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </ToggleButton.Template>
                            </ToggleButton>

                            <ContentPresenter x:Name="ContentSite" 
                                              IsHitTestVisible="False" 
                                              Content="{TemplateBinding SelectionBoxItem}"
                                              ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}"
                                              ContentTemplateSelector="{TemplateBinding ItemTemplateSelector}"
                                              Margin="8,1,22,1" 
                                              VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                                              HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"/>

                            <Popup x:Name="Popup" 
                                   Placement="Bottom" 
                                   IsOpen="{TemplateBinding IsDropDownOpen}" 
                                   AllowsTransparency="True" 
                                   Focusable="False" 
                                   PopupAnimation="Slide">
                                <Grid x:Name="DropDown" 
                                      SnapsToDevicePixels="True" 
                                      MinWidth="{TemplateBinding ActualWidth}" 
                                      MaxHeight="{TemplateBinding MaxDropDownHeight}">
                                    <Border x:Name="DropDownBorder" 
                                            Background="#0A0D14" 
                                            BorderBrush="#221617" 
                                            BorderThickness="1" 
                                            CornerRadius="2"/>
                                    <ScrollViewer Margin="4,6" SnapsToDevicePixels="True">
                                        <ItemsPresenter KeyboardNavigation.DirectionalNavigation="Contained" />
                                    </ScrollViewer>
                                </Grid>
                            </Popup>
                        </Grid>

                        <ControlTemplate.Triggers>
                            <Trigger Property="HasItems" Value="false">
                                <Setter TargetName="DropDownBorder" Property="Height" Value="95"/>
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="true">
                                <Setter Property="Foreground" Value="#94A3B8"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="ComboBoxItem">
            <Setter Property="SnapsToDevicePixels" Value="true"/>
            <Setter Property="Foreground" Value="#D1D5DB"/>
            <Setter Property="Padding" Value="6,4"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBoxItem">
                        <Border x:Name="Border" 
                                Padding="{TemplateBinding Padding}" 
                                Background="Transparent" 
                                CornerRadius="2" 
                                Margin="2,1">
                            <ContentPresenter />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="true">
                                <Setter TargetName="Border" Property="Background" Value="#1C2333"/>
                                <Setter Property="Foreground" Value="#F43F5E"/>
                            </Trigger>
                            <Trigger Property="IsSelected" Value="true">
                                <Setter TargetName="Border" Property="Background" Value="#2D1112"/>
                                <Setter Property="Foreground" Value="#E11D48"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- 3. Стили для TabControl и TabItem -->
        <Style TargetType="TabControl">
            <Setter Property="Padding" Value="0"/>
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TabControl">
                        <Grid ClipToBounds="true" SnapsToDevicePixels="true" KeyboardNavigation.TabNavigation="Local">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>
                            <StackPanel x:Name="HeaderPanel" 
                                        Grid.Row="0" 
                                        IsItemsHost="true" 
                                        Orientation="Horizontal" 
                                        HorizontalAlignment="Center" 
                                        Margin="0,4,0,12"/>
                            <ContentPresenter x:Name="PART_SelectedContentHost" Grid.Row="1" ContentSource="SelectedContent"/>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="TabItem">
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Foreground" Value="#8A9FBF"/>
            <Setter Property="Background" Value="#0A0D14"/>
            <Setter Property="BorderBrush" Value="#1F2937"/>
            <Setter Property="Height" Value="26"/>
            <Setter Property="Margin" Value="2,0"/>
            <Setter Property="Padding" Value="14,0"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="HorizontalContentAlignment" Value="Center"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TabItem">
                        <Border x:Name="Border" 
                                Background="{TemplateBinding Background}" 
                                BorderBrush="{TemplateBinding BorderBrush}" 
                                BorderThickness="1" 
                                CornerRadius="3" 
                                SnapsToDevicePixels="True">
                            <ContentPresenter x:Name="ContentSite"
                                              VerticalAlignment="Center"
                                              HorizontalAlignment="Center"
                                              ContentSource="Header"
                                              Margin="{TemplateBinding Padding}"
                                              RecognizesAccessKey="True"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Border" Property="Background" Value="#121620"/>
                                <Setter TargetName="Border" Property="BorderBrush" Value="#374151"/>
                                <Setter Property="Foreground" Value="#D1D5DB"/>
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="Border" Property="Background" Value="#991B1B"/>
                                <Setter TargetName="Border" Property="BorderBrush" Value="#B91C1C"/>
                                <Setter Property="Foreground" Value="White"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- 4. Style для Window (перемещен в конец ресурсов) -->
        <Style x:Key="CustomWindowChromeStyle" TargetType="Window">
            <Setter Property="WindowChrome.WindowChrome">
                <Setter.Value>
                    <WindowChrome CaptionHeight="32" 
                                  ResizeBorderThickness="0" 
                                  GlassFrameThickness="0" 
                                  CornerRadius="0"/>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Window.Style>
        <StaticResource ResourceKey="CustomWindowChromeStyle"/>
    </Window.Style>

    <!-- Корневой контейнер, обеспечивающий темный фон, красивую обводку и скругления без системных артефактов -->
    <Border Background="#05070A" BorderBrush="#1F2937" BorderThickness="1" CornerRadius="4">
        <Grid Margin="12">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition x:Name="SettingsRow" Height="Auto"/>
            </Grid.RowDefinitions>

            <Grid Grid.Row="0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- Верхний бар: Иконка, Заголовок, Кнопка Настроек и Кнопки Управления -->
                <Grid Grid.Row="0" Margin="0,0,0,10">
                    <!-- Заголовок и иконка слева -->
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Left" VerticalAlignment="Center">
                        <Image Source="{Binding Icon, RelativeSource={RelativeSource AncestorType=Window}}" 
                               Width="16" Height="16" 
                               Margin="0,0,8,0"
                               RenderOptions.BitmapScalingMode="HighQuality"/>
                        <TextBlock Text="VOICE PHRASE CAST" Foreground="#FF3344" FontSize="13" FontWeight="Bold" VerticalAlignment="Center"/>
                    </StackPanel>

                    <!-- Кнопки управления справа -->
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                        <!-- Настройки -->
                        <Button x:Name="BtnSettings" Content="⚙ Настройки" Click="BtnSettings_Click"
                                WindowChrome.IsHitTestVisibleInChrome="True"
                                Width="90" Height="22" FontSize="12" Margin="0,0,10,0"
                                Background="#121620" Foreground="#8A9FBF" BorderThickness="0" Cursor="Hand"/>

                        <!-- Свернуть -->
                        <Button x:Name="BtnMinimize" Content="0" Click="BtnMinimize_Click"
                                WindowChrome.IsHitTestVisibleInChrome="True"
                                FontFamily="Marlett" FontSize="12" Width="24" Height="22" Margin="0,0,5,0"
                                Background="#121620" Foreground="#8A9FBF" BorderThickness="0" Cursor="Hand"/>

                        <!-- Закрыть -->
                        <Button x:Name="BtnClose" Content="r" Click="BtnClose_Click"
                                WindowChrome.IsHitTestVisibleInChrome="True"
                                FontFamily="Marlett" FontSize="12" Width="24" Height="22"
                                Background="#1A1112" Foreground="#EF4444" BorderThickness="0" Cursor="Hand"/>
                    </StackPanel>
                </Grid>

                <!-- Основные кнопки запуска -->
                <Grid Grid.Row="1" Margin="0,0,0,10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="2*"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Button x:Name="BtnStart" Content="ЗАПУСТИТЬ" Height="36" FontWeight="Bold" FontSize="13"
                            Background="#991B1B" Foreground="White" BorderThickness="0" Cursor="Hand" Click="BtnStart_Click"/>
                    <Button x:Name="BtnStop" Grid.Column="1" Content="Стоп" Height="36" Margin="6,0,0,0" FontWeight="Bold" FontSize="12"
                            Background="#1A1112" Foreground="#EF4444" BorderBrush="#991B1B" BorderThickness="1" IsEnabled="False" Cursor="Hand" Click="BtnStop_Click"/>
                </Grid>

                <!-- Статус распознавания и кнопка проверки -->
                <StackPanel Grid.Row="2" Margin="0,0,0,5">
                    <TextBlock x:Name="RecognizedText" Text="Слышу: ..." FontSize="13" Foreground="#FCA5A5" FontWeight="Bold" Margin="0,0,0,6"/>
                    <Button x:Name="BtnTestSound" Content="🔊 Проверить тестовый звук" Height="22" FontSize="12" Margin="0,0,0,6"
                            WindowChrome.IsHitTestVisibleInChrome="True"
                            Background="#111622" Foreground="#7DD3FC" BorderThickness="0" Cursor="Hand" Click="BtnTestSound_Click"/>
                </StackPanel>

                <TextBlock x:Name="StatusText" Grid.Row="3" Text="Статус ИИ: Ожидание..." Foreground="#4B5563" FontSize="11" Margin="0,0,0,10"/>
            </Grid>

            <!-- Скрываемая панель настроек -->
            <ScrollViewer x:Name="SettingsPanel" Grid.Row="1" VerticalScrollBarVisibility="Hidden" Margin="0,5,0,0" Height="0" VerticalAlignment="Top" WindowChrome.IsHitTestVisibleInChrome="True">
                <StackPanel>
                    <Rectangle Height="1" Fill="#261A1B" Margin="0,5,0,10"/>

                    <TabControl>
                        <!-- Вкладка SpeechToPhrase (Все текущие настройки) -->
                        <TabItem Header="SpeechToPhrase">
                            <StackPanel Margin="0,10,0,0">
                                <TextBlock Text="АУДИОУСТРОЙСТВА" Foreground="#991B1B" FontWeight="Bold" FontSize="11" Margin="0,0,0,6"/>
                                <Grid Margin="0,0,0,10">
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                    </Grid.RowDefinitions>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="80"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>

                                    <TextBlock Text="Микрофон:" VerticalAlignment="Center" Margin="0,0,0,6"/>
                                    <ComboBox x:Name="MicComboBox" DisplayMemberPath="Name" Grid.Column="1" Margin="0,0,0,6"/>

                                    <TextBlock Text="Вирт. кабель:" Grid.Row="1" VerticalAlignment="Center" Margin="0,0,0,6"/>
                                    <ComboBox x:Name="CableComboBox" DisplayMemberPath="Name" Grid.Row="1" Grid.Column="1" Margin="0,0,0,6"/>

                                    <TextBlock Text="Наушники:" Grid.Row="2" VerticalAlignment="Center"/>
                                    <ComboBox x:Name="MonitorComboBox" DisplayMemberPath="Name" Grid.Row="2" Grid.Column="1"/>
                                </Grid>

                                <!-- Секция управления моделями Vosk -->
                                <GroupBox Header="Модель распознавания речи (Vosk)" Margin="0,10,0,10" Padding="10">
                                    <Grid>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="Auto"/>
                                        </Grid.RowDefinitions>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>

                                        <!-- Выпадающий список моделей -->
                                        <ComboBox x:Name="CmbVoskModels" 
                                            Grid.Row="0" Grid.Column="0" 
                                            Margin="0,0,5,5" 
                                            VerticalAlignment="Center"
                                            SelectionChanged="CmbVoskModels_SelectionChanged"/>

                                        <StackPanel Grid.Row="0" Grid.Column="1" Orientation="Horizontal">
                                            <!-- Кнопка Обновить -->
                                            <Button x:Name="BtnRefreshModels" 
                                                Content="🔄" Width="30" Height="26" Margin="0,0,5,0" 
                                                ToolTip="Обновить список моделей"
                                                Click="BtnRefreshModels_Click"/>

                                            <!-- Кнопка Обзор / Выбрать папку -->
                                            <Button x:Name="BtnBrowseModelFolder" 
                                                Content="🔍 Выбрать..." Padding="8,2" Height="26" Margin="0,0,5,0" 
                                                ToolTip="Указать папку с моделью на диске"
                                                Click="BtnBrowseModelFolder_Click"/>

                                            <!-- Кнопка Открыть папку models -->
                                            <Button x:Name="BtnOpenModelsFolder" 
                                                Content="📁 Папка" Padding="8,2" Height="26" 
                                                ToolTip="Открыть системную папку models/ в Проводнике"
                                                Click="BtnOpenModelsFolder_Click"/>
                                        </StackPanel>

                                        <!-- Текст-подсказка под комбобоксом -->
                                        <TextBlock x:Name="TxtModelInfo" 
                                            Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="3" 
                                            Foreground="Gray" FontSize="11" TextWrapping="Wrap"
                                            Text="Выберите модель для распознавания. Изменения применятся после перезагрузки модели."/>  
                                    </Grid>
                                </GroupBox>

                                <TextBlock Text="БАЗА ЗВУКОВЫХ ФРАЗ" Foreground="#991B1B" FontWeight="Bold" FontSize="11" Margin="0,0,0,6"/>
                                <Grid Margin="0,0,0,10">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="54"/>
                                        <ColumnDefinition Width="30"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBox x:Name="TxtPath" IsReadOnly="True" Background="#0A0F1D" Foreground="#4B5563" FontSize="12"
                                             BorderBrush="#1F2937" Height="24" Padding="5,0" VerticalContentAlignment="Center"/>
                                    <Button x:Name="BtnBrowse" Grid.Column="1" Content="Обзор" Click="BtnBrowse_Click" FontSize="12"
                                            Width="48" Height="24" Margin="6,0,0,0" Background="#1F2937" Foreground="White" BorderThickness="0" Cursor="Hand"/>
                                    <Button x:Name="BtnOpenFolder" Grid.Column="2" Content="📁" Click="BtnOpenFolder_Click" FontSize="12"
                                            Width="26" Height="24" Background="#1F2937" Foreground="White" BorderThickness="0" Cursor="Hand"/>
                                </Grid>

                                <TextBlock Text="ГОРЯЧИЕ КЛАВИШИ" Foreground="#991B1B" FontWeight="Bold" FontSize="11" Margin="0,0,0,8"/>
                                <UniformGrid Columns="3" Margin="0,0,0,12">
                                    <StackPanel Margin="0,0,6,0">
                                        <TextBlock Text="Запись (ИИ)" Foreground="#8A9FBF" FontSize="11" Margin="0,0,0,4" HorizontalAlignment="Center"/>
                                        <TextBox x:Name="TxtActivationKey" Text="F1" Height="26" IsReadOnly="True" Focusable="True" 
                                                 PreviewKeyDown="KeyField_PreviewKeyDown" Cursor="Hand" Background="#2D1517" Foreground="#EF4444" 
                                                 FontWeight="Bold" FontSize="12" TextAlignment="Center" VerticalContentAlignment="Center" BorderBrush="#7F1D1D"/>
                                    </StackPanel>

                                    <StackPanel Margin="3,0,3,0">
                                        <TextBlock Text="Рация в игре" Foreground="#8A9FBF" FontSize="11" Margin="0,0,0,4" HorizontalAlignment="Center"/>
                                        <TextBox x:Name="TxtEmulationKey" Text="G" Height="26" IsReadOnly="True" Focusable="True" 
                                                 PreviewKeyDown="KeyField_PreviewKeyDown" Cursor="Hand" Background="#241A10" Foreground="#F59E0B" 
                                                 FontWeight="Bold" FontSize="12" TextAlignment="Center" VerticalContentAlignment="Center" BorderBrush="#78350F"/>
                                    </StackPanel>

                                    <StackPanel Margin="6,0,0,0">
                                        <TextBlock Text="Стоп звука" Foreground="#8A9FBF" FontSize="11" Margin="0,0,0,4" HorizontalAlignment="Center"/>
                                        <TextBox x:Name="TxtStopKey" Text="Scroll" Height="26" IsReadOnly="True" Focusable="True" 
                                                 PreviewKeyDown="KeyField_PreviewKeyDown" Cursor="Hand" Background="#1E293B" Foreground="#94A3B8" 
                                                 FontWeight="Bold" FontSize="12" TextAlignment="Center" VerticalContentAlignment="Center" BorderBrush="#334155"/>
                                    </StackPanel>
                                </UniformGrid>

                                <TextBlock Text="НАСТРОЙКА ГРОМКОСТИ" Foreground="#991B1B" FontWeight="Bold" FontSize="11" Margin="0,0,0,4"/>
                                <StackPanel Margin="0,0,0,5">
                                    <Grid Margin="0,0,0,2">
                                        <TextBlock Text="Громкость для себя:" FontSize="11" Foreground="#4B5563"/>
                                        <TextBlock x:Name="TxtMicVolumeValue" Text="100%" FontSize="11" Foreground="#EF4444" FontWeight="Bold" HorizontalAlignment="Right"/>
                                    </Grid>
                                    <Slider x:Name="SliderMic" Minimum="0" Maximum="1" Value="1" Height="16" Margin="0,0,0,4" ValueChanged="SliderMic_ValueChanged"/>

                                    <Grid Margin="0,0,0,2">
                                        <TextBlock Text="Громкость в игру:" FontSize="11" Foreground="#4B5563"/>
                                        <TextBlock x:Name="TxtCableVolumeValue" Text="100%" FontSize="11" Foreground="#EF4444" FontWeight="Bold" HorizontalAlignment="Right"/>
                                    </Grid>
                                    <Slider x:Name="SliderCable" Minimum="0" Maximum="1" Value="1" Height="16" Margin="0,0,0,6" ValueChanged="SliderCable_ValueChanged"/>

                                    <CheckBox x:Name="ChkMonitor" Content="Включить самопрослушивание фраз" Foreground="#9CA3AF" FontSize="11" 
                                              VerticalContentAlignment="Center" Cursor="Hand" Checked="ChkMonitor_Click" Unchecked="ChkMonitor_Click"/>
                                    <CheckBox x:Name="ChkEmulationEnabled" 
                                              Content="Включить эмуляцию рации в игре" 
                                              Foreground="#F59E0B" 
                                              FontWeight="SemiBold"
                                              Margin="0,4,0,4"
                                              IsChecked="True"
                                              Click="ChkEmulationEnabled_Click"/>
                                    <CheckBox x:Name="ChkAutostartWindows" 
                                              Content="Запускать программу при старте Windows" 
                                              Foreground="#9CA3AF" 
                                              FontSize="11" 
                                              Margin="0,0,0,4"
                                              VerticalContentAlignment="Center" 
                                              Cursor="Hand" 
                                              Click="ChkAutostartWindows_Click"/>

                                    <CheckBox x:Name="ChkAutoBridgeStart" 
                                              Content="Автоматически запускать мост при старте программы" 
                                              Foreground="#9CA3AF" 
                                              FontSize="11" 
                                              Margin="0,0,0,4"
                                              VerticalContentAlignment="Center" 
                                              Cursor="Hand" 
                                              Click="ChkAutoBridgeStart_Click"/>
                                    <CheckBox x:Name="ChkMinimizeOnStart" 
                                              Content="Сворачивать в трей при запуске моста" 
                                              Foreground="#9CA3AF" 
                                              FontSize="11" 
                                              Margin="0,0,0,4"
                                              VerticalContentAlignment="Center" 
                                              Cursor="Hand" 
                                              Click="ChkMinimizeOnStart_Click"/>
                                </StackPanel>

                                <Border Background="#020406" CornerRadius="2" Padding="6" Margin="0,5,0,0">
                                    <TextBlock x:Name="HintText" Text="💡 Подсказка: Укажите Virtual Cable как устройство ввода в Discord/игре." Foreground="#4B5563" FontSize="11" TextWrapping="Wrap" LineHeight="13"/>
                                </Border>
                            </StackPanel>
                        </TabItem>

                        <!-- Вкладка SpeechToText (Готова для будущих элементов) -->
                        <TabItem Header="SpeechToText">
                            <StackPanel Margin="0,10,0,0">
                                <TextBlock Text="ГОРЯЧИЕ КЛАВИШИ" Foreground="#991B1B" FontWeight="Bold" FontSize="11" Margin="0,0,0,6"/>

                                <!-- Хоткей записи для КОМАНДНОГО чата -->
                                <Grid Margin="0,0,0,6">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="110"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="Запись для союзного чата (Enter):" VerticalAlignment="Center"/>
                                    <TextBox x:Name="TxtSttTeamHotkey" Grid.Column="1" Text="7" Height="24" IsReadOnly="True" Focusable="True" 
                     PreviewKeyDown="KeyField_PreviewKeyDown" Cursor="Hand" Background="#2D1517" Foreground="#EF4444" 
                     FontWeight="Bold" FontSize="12" TextAlignment="Center" VerticalContentAlignment="Center" BorderBrush="#7F1D1D"/>
                                </Grid>

                                <!-- Хоткей записи для ОБЩЕГО чата -->
                                <Grid Margin="0,0,0,10">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="110"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="Запись для общего чата (Shift+Enter):" VerticalAlignment="Center"/>
                                    <TextBox x:Name="TxtSttAllHotkey" Grid.Column="1" Text="8" Height="24" IsReadOnly="True" Focusable="True" 
                     PreviewKeyDown="KeyField_PreviewKeyDown" Cursor="Hand" Background="#1E293B" Foreground="#38BDF8" 
                     FontWeight="Bold" FontSize="12" TextAlignment="Center" VerticalContentAlignment="Center" BorderBrush="#334155"/>
                                </Grid>

                                <TextBlock Text="НАСТРОЙКИ ВВОДА ТЕКСТА" Foreground="#991B1B" FontWeight="Bold" FontSize="11" Margin="0,0,0,6"/>
                                <StackPanel Margin="0,0,0,5">
                                    <CheckBox x:Name="ChkAutoPaste" Content="Автоматически вставлять текст в активное окно" Foreground="#F59E0B" FontWeight="SemiBold" IsChecked="True" Margin="0,0,0,4"/>
                                    <CheckBox x:Name="ChkOpenChatBeforePaste" Content="Нажимать клавишу чата перед вставкой" Foreground="#9CA3AF" FontSize="11" IsChecked="True" Margin="0,0,0,4"/>
                                    <CheckBox x:Name="ChkUseClipboard" Content="Использовать Ctrl+V вместо прямой эмуляции" Foreground="#9CA3AF" FontSize="11" IsChecked="True" Margin="0,0,0,4"/>
                                    <CheckBox x:Name="ChkSendEnterAfterText" Content="Нажимать Enter после вставки текста" Foreground="#9CA3AF" FontSize="11" IsChecked="True" Margin="0,0,0,4"/>
                                </StackPanel>
                            </StackPanel>
                        </TabItem>
                    </TabControl>

                </StackPanel>
            </ScrollViewer>
        </Grid>
    </Border>
</Window>